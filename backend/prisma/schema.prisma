generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  STUDENT
  ADMIN
}

model User {
  id              String                  @id @default(uuid()) @db.Uuid
  name            String
  email           String                  @unique
  passwordHash    String
  role            Role                    @default(STUDENT)
  active          Boolean                 @default(true)
  /// RF-AUTH-05: la cuenta nace inactiva y se activa al confirmar el OTP de verificación.
  verifiedAt      DateTime?
  documentType    String?
  documentNumber  String?
  /// RF-AUTH-06: foto de perfil (URL o data-URL pequeña).
  avatarUrl       String?
  /// RF-NOT-04: canal preferido (IN_APP | EMAIL | BOTH).
  notifyChannel   String                  @default("BOTH")
  /// RF-NOT-02: minutos de antelación del recordatorio de clase.
  reminderMinutes Int                     @default(15)
  enrollments     Enrollment[]
  sessions        ClassSession[]
  notifications   Notification[]
  otps            Otp[]
  refreshTokens   RefreshToken[]
  activities      GapActivity[]
  gapSlots        GapSlot[]
  scheduled       ScheduledNotification[]
}

/// RF-AUTH-04/05, RNF-07: código de un solo uso (se guarda su hash, nunca el código).
model Otp {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  purpose   String // VERIFY | RESET
  codeHash  String
  expiresAt DateTime
  usedAt    DateTime?
  attempts  Int       @default(0)
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose, createdAt])
}

/// RNF-05: refresh token rotativo (se guarda su hash).
model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// RF-ADM-01 / RRF-03: todo programa pertenece a una facultad.
model Faculty {
  id       String    @id @default(uuid()) @db.Uuid
  name     String    @unique
  programs Program[]
}

model Program {
  id        String  @id @default(uuid()) @db.Uuid
  code      String  @unique
  name      String
  facultyId String  @db.Uuid
  faculty   Faculty @relation(fields: [facultyId], references: [id])

  @@index([facultyId])
}

/// RF-HUE-03: actividad propia asignada a un hueco (identificado por día + franja).
model GapActivity {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  weekday   Int
  startTime String
  endTime   String
  title     String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, weekday, startTime, endTime])
}

/// RF-HUE-04: hueco marcado como OCCUPIED o AVAILABLE.
model GapSlot {
  id        String @id @default(uuid()) @db.Uuid
  userId    String @db.Uuid
  weekday   Int
  startTime String
  endTime   String
  status    String // OCCUPIED | AVAILABLE
  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, weekday, startTime, endTime])
}

/// RF-NOT-01/02: notificaciones programadas (propias o recordatorios de clase). `dedupKey` evita duplicados.
model ScheduledNotification {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  kind      String // CUSTOM | CLASS_REMINDER
  title     String
  message   String
  fireAt    DateTime
  firedAt   DateTime?
  dedupKey  String?   @unique
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([firedAt, fireAt])
  @@index([userId, fireAt])
}

model Enrollment {
  id       String  @id @default(uuid()) @db.Uuid
  userId   String  @db.Uuid
  semester String
  active   Boolean @default(true)
  user     User    @relation(fields: [userId], references: [id])

  @@unique([userId, semester])
}

model ClassSession {
  id         String @id @default(uuid()) @db.Uuid
  externalId String
  userId     String @db.Uuid
  semester   String
  courseCode String
  courseName String
  teacher    String
  weekday    Int
  startTime  String
  endTime    String
  block      String
  floor      Int
  room       String
  status     String @default("ACTIVE")
  user       User   @relation(fields: [userId], references: [id])

  @@unique([userId, externalId])
  @@index([userId, semester, weekday])
}

model ScheduleChange {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @db.Uuid
  externalId String
  type       String
  before     Json?
  after      Json?
  createdAt  DateTime @default(now())

  @@index([userId, createdAt])
}

model SyncRun {
  id             String    @id @default(uuid()) @db.Uuid
  trigger        String
  actorId        String?
  startedAt      DateTime  @default(now())
  finishedAt     DateTime?
  studentsSynced Int       @default(0)
  changesCount   Int       @default(0)
  status         String    @default("RUNNING")
  stats          Json?
}

model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  actorId   String?
  action    String
  entity    String
  detail    Json?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model RevokedToken {
  jti       String   @id
  expiresAt DateTime
}

model DomainEvent {
  id         String          @id @default(uuid()) @db.Uuid
  type       String
  payload    Json
  occurredAt DateTime        @default(now())
  deliveries EventDelivery[]

  @@index([occurredAt])
}

model EventDelivery {
  id          String      @id @default(uuid()) @db.Uuid
  eventId     String      @db.Uuid
  observer    String
  status      String
  attempts    Int
  error       String?
  deliveredAt DateTime    @default(now())
  event       DomainEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
}

model Notification {
  id             String    @id @default(uuid()) @db.Uuid
  userId         String    @db.Uuid
  kind           String
  title          String
  message        String
  createdAt      DateTime  @default(now())
  readAt         DateTime?
  emailedAt      DateTime?
  /// Terminal: el correo no aplica (usuario inexistente o inactivo); nunca se vuelve a intentar.
  emailSkippedAt DateTime?
  /// Envíos fallidos; al llegar al tope el job de pendientes deja de reintentar.
  emailAttempts  Int       @default(0)
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([emailedAt, createdAt])
}
